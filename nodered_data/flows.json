        "id": "mqtt_in_telemetry",
        "type": "mqtt in",
        "z": "tab_smart_energy",
        "name": "Nhận dữ liệu PZEM-004T (MQTT)",
        "topic": "home/energy/telemetry",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 170,
        "y": 160,
