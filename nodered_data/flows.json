    {
        "id": "ui_global_css",
        "type": "ui_template",
        "z": "tab_smart_energy",
        "group": "ui_group_realtime",
        "name": "CSS Giao diện Hiện đại",
        "order": 99,
        "width": 0,
        "height": 0,
        "format": "<style>\n  /* Bo góc và đổ bóng hiện đại cho các Group Card */\n  .nr-dashboard-cardpanel {\n    border-radius: 12px !important;\n    border: 1px solid #1e293b !important;\n    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5) !important;\n    overflow: hidden;\n  }\n  .nr-dashboard-cardtitle {\n    font-weight: 700 !important;\n    font-size: 15px !important;\n    letter-spacing: 0.2px;\n    padding: 12px 16px 8px 16px !important;\n    border-bottom: 1px solid rgba(56, 189, 248, 0.15);\n  }\n  /* Nút bấm đẹp, không bị cắt chữ */\n  .nr-dashboard-button .md-button {\n    border-radius: 8px !important;\n    font-weight: 600 !important;\n    letter-spacing: 0.3px;\n    text-transform: none !important;\n    font-size: 13.5px !important;\n  }\n  /* KPI Cards trong Group 1 & Group 2 */\n  .kpi-grid-4 {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 10px;\n    height: 100%;\n    align-items: center;\n    padding: 4px 2px;\n  }\n  .kpi-grid-2 {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 12px;\n    height: 100%;\n    align-items: center;\n    padding: 4px 2px;\n  }\n  .kpi-box {\n    background: linear-gradient(145deg, #1e293b, #0f172a);\n    border: 1px solid #334155;\n    border-radius: 10px;\n    padding: 10px 12px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n  .kpi-label {\n    font-size: 12px;\n    color: #94a3b8;\n    margin-bottom: 4px;\n    white-space: nowrap;\n  }\n  .kpi-val {\n    font-size: 20px;\n    font-weight: 700;\n    color: #f8fafc;\n    white-space: nowrap;\n  }\n  .kpi-val.cyan { color: #38bdf8; }\n  .kpi-val.green { color: #34d399; }\n  .kpi-val.amber { color: #fbbf24; }\n  .status-banner {\n    border-radius: 8px;\n    padding: 9px 14px;\n    font-weight: 700;\n    font-size: 13.5px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    border: 1px solid transparent;\n  }\n  .status-normal {\n    background: rgba(16, 185, 129, 0.15);\n    border-color: rgba(16, 185, 129, 0.4);\n    color: #34d399;\n  }\n  .status-overload {\n    background: rgba(239, 68, 68, 0.2);\n    border-color: rgba(239, 68, 68, 0.5);\n    color: #f87171;\n  }\n  .status-warn {\n    background: rgba(245, 158, 11, 0.2);\n    border-color: rgba(245, 158, 11, 0.5);\n    color: #fbbf24;\n  }\n  .status-off {\n    background: rgba(100, 116, 139, 0.25);\n    border-color: rgba(148, 163, 184, 0.4);\n    color: #cbd5e1;\n  }\n</style>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "global",
