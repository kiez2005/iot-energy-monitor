    {
        "id": "func_process_telemetry",
        "type": "function",
        "z": "tab_smart_energy",
        "name": "Xử lý dữ liệu & Kiểm tra ngưỡng",
        "func": "let d = msg.payload;\nif (!d || typeof d !== 'object') return null;\n\nlet threshold = flow.get('power_threshold') || 3000;\n\n// Xác định trạng thái cảnh báo\nlet statusCode = 'NORMAL';\nlet statusLabel = '🟢 HỆ THỐNG BÌNH THƯỜNG (Ổn định)';\nlet statusClass = 'status-normal';\n\nif (d.relay === 'OFF') {\n    statusCode = 'OFF';\n    statusLabel = '⚫ ĐÃ NGẮT APTOMAT TỔNG (Relay OFF)';\n    statusClass = 'status-off';\n} else if (d.power > threshold) {\n    statusCode = 'OVERLOAD';\n    statusLabel = `🔴 CẢNH BÁO QUÁ TẢI (${d.power}W > Ngưỡng ${threshold}W)!`;\n    statusClass = 'status-overload';\n} else if (d.voltage < 200) {\n    statusCode = 'UNDER_VOLTAGE';\n    statusLabel = `🟡 CẢNH BÁO SỤT ÁP LƯỚI (${d.voltage}V < 200V)!`;\n    statusClass = 'status-warn';\n} else if (d.voltage > 240) {\n    statusCode = 'OVER_VOLTAGE';\n    statusLabel = `🔴 CẢNH BÁO QUÁ ÁP (${d.voltage}V > 240V)!`;\n    statusClass = 'status-overload';\n}\n\nlet rooms = d.rooms || { living_room: 0, kitchen: 0, bedroom: 0 };\nlet costStr = Number(d.cost_vnd || Math.round(d.energy * 2500)).toLocaleString('vi-VN');\n\n// 1. Điện áp & Công suất cho 2 đồng hồ Gauge\nlet msgU = { payload: d.voltage };\nlet msgP = { payload: d.power, topic: 'Tổng công suất (W)' };\n\n// 2. Gói tin tổng hợp cho thẻ KPI Group 1 & Group 2\nlet msgKPI = {\n    payload: {\n        voltage: d.voltage,\n        current: Number(d.current).toFixed(2),\n        power: d.power,\n        energy: Number(d.energy).toFixed(3),\n        pf: Number(d.pf).toFixed(2),\n        frequency: Number(d.frequency).toFixed(1),\n        cost_vnd: costStr,\n        relay: d.relay || 'ON',\n        threshold: threshold,\n        statusCode: statusCode,\n        statusLabel: statusLabel,\n        statusClass: statusClass,\n        rooms: rooms\n    }\n};\n\n// 3. Đồ thị từng phòng\nlet msgRoom1 = { topic: 'Phòng khách', payload: rooms.living_room };\nlet msgRoom2 = { topic: 'Nhà bếp', payload: rooms.kitchen };\nlet msgRoom3 = { topic: 'Phòng ngủ', payload: rooms.bedroom };\n\n// 4. Chuẩn bị câu lệnh INSERT vào MySQL định kỳ (mỗi 3 gói tin ~ 6 giây hoặc khi có sự cố)\nlet counter = (flow.get('sql_counter') || 0) + 1;\nflow.set('sql_counter', counter);\nlet msgSQLInsert = null;\n\nif (counter % 3 === 0 || statusCode === 'OVERLOAD' || statusCode === 'UNDER_VOLTAGE') {\n    let sql = `INSERT INTO energy_logs (device_id, voltage, current_amp, power_watt, energy_kwh, power_factor, frequency, living_room_w, kitchen_w, bedroom_w, relay_state, status_alert) VALUES ('${d.device_id || 'ESP32_PZEM_MAIN'}', ${d.voltage}, ${d.current}, ${d.power}, ${d.energy}, ${d.pf}, ${d.frequency}, ${rooms.living_room}, ${rooms.kitchen}, ${rooms.bedroom}, '${d.relay || 'ON'}', '${statusCode}');`;\n    msgSQLInsert = { topic: sql, payload: d };\n}\n\nreturn [\n    msgU,\n    msgP,\n    msgKPI,\n    [msgRoom1, msgRoom2, msgRoom3],\n    msgSQLInsert\n];",
        "outputs": 5,
        "noerr": 0,
        "initialize": "flow.set('power_threshold', 3000);\nflow.set('sql_counter', 0);",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 160,
        "wires": [
