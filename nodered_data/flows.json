    {
        "id": "func_format_mysql_table",
        "type": "function",
        "z": "tab_smart_energy",
        "name": "Chuẩn hóa dữ liệu bảng & Thống kê",
        "func": "let rows = Array.isArray(msg.payload) ? msg.payload : [];\nlet maxP = 0;\nlet sumU = 0;\nfor (let r of rows) {\n    if (Number(r.power_watt) > maxP) maxP = Number(r.power_watt);\n    sumU += Number(r.voltage || 0);\n}\nlet avgU = rows.length > 0 ? (sumU / rows.length).toFixed(1) : '0.0';\nlet summaryMsg = {\n    payload: `Hiển thị ${rows.length} bản ghi | U_tb = ${avgU}V | Công suất đỉnh P_max = ${maxP}W`\n};\nreturn [\n    { payload: rows },\n    summaryMsg\n];",
        "outputs": 2,
        "noerr": 0,
        "x": 1030,
        "y": 620,
        "wires": [
            [
                "ui_template_mysql_table"
            ],
            [
                "text_mysql_summary"
            ]
        ]
    },
    {
        "id": "ui_template_mysql_table",
        "type": "ui_template",
        "z": "tab_smart_energy",
        "group": "ui_group_mysql",
        "name": "Bảng dữ liệu MySQL (HTML Table)",
        "order": 4,
        "width": "22",
        "height": "7",
        "format": "<style>\n  .iot-sql-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 13.5px;\n    color: #e2e8f0;\n  }\n  .iot-sql-table th {\n    background-color: #0f172a;\n    color: #38bdf8;\n    padding: 10px 12px;\n    text-align: center;\n    border-bottom: 2px solid #334155;\n    position: sticky;\n    top: 0;\n    white-space: nowrap;\n    z-index: 2;\n  }\n  .iot-sql-table td {\n    padding: 9px 12px;\n    text-align: center;\n    border-bottom: 1px solid #1e293b;\n    white-space: nowrap;\n  }\n  .iot-sql-table tr:nth-child(even) {\n    background-color: rgba(15, 23, 42, 0.45);\n  }\n  .iot-sql-table tr:hover {\n    background-color: rgba(56, 189, 248, 0.12);\n  }\n  .badge-normal {\n    background: rgba(16, 185, 129, 0.2);\n    color: #34d399;\n    padding: 4px 10px;\n    border-radius: 12px;\n    font-weight: 600;\n    font-size: 12px;\n  }\n  .badge-overload {\n    background: rgba(239, 68, 68, 0.25);\n    color: #f87171;\n    padding: 4px 10px;\n    border-radius: 12px;\n    font-weight: 600;\n    font-size: 12px;\n  }\n  .badge-warn {\n    background: rgba(245, 158, 11, 0.25);\n    color: #fbbf24;\n    padding: 4px 10px;\n    border-radius: 12px;\n    font-weight: 600;\n    font-size: 12px;\n  }\n</style>\n\n<div style=\"overflow-x: auto; max-height: 330px;\">\n  <table class=\"iot-sql-table\">\n    <thead>\n      <tr>\n        <th>Mã ID</th>\n        <th>Thời gian ghi (MySQL)</th>\n        <th>Điện áp (U)</th>\n        <th>Dòng điện (I)</th>\n        <th>Tổng Công Suất (P)</th>\n        <th>Điện năng (kWh)</th>\n        <th>Hệ số Cos(φ)</th>\n        <th>Phòng khách</th>\n        <th>Nhà bếp</th>\n        <th>Phòng ngủ</th>\n        <th>Aptomat</th>\n        <th>Trạng thái</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr ng-repeat=\"row in msg.payload\">\n        <td style=\"color: #94a3b8;\">#{{row.id}}</td>\n        <td>{{row.recorded_at}}</td>\n        <td><b>{{row.voltage}} V</b></td>\n        <td>{{row.current_amp}} A</td>\n        <td style=\"color: #38bdf8; font-weight: 700;\">{{row.power_watt}} W</td>\n        <td style=\"color: #fbbf24;\">{{row.energy_kwh}} kWh</td>\n        <td>{{row.power_factor}}</td>\n        <td>{{row.living_room_w}} W</td>\n        <td>{{row.kitchen_w}} W</td>\n        <td>{{row.bedroom_w}} W</td>\n        <td><b>{{row.relay_state}}</b></td>\n        <td>\n          <span ng-class=\"{\n            'badge-normal': row.status_alert === 'NORMAL',\n            'badge-overload': row.status_alert === 'OVERLOAD',\n            'badge-warn': row.status_alert !== 'NORMAL' && row.status_alert !== 'OVERLOAD'\n          }\">\n            {{row.status_alert}}\n          </span>\n        </td>\n      </tr>\n      <tr ng-if=\"!msg.payload || msg.payload.length === 0\">\n        <td colspan=\"12\" style=\"padding: 24px; color: #94a3b8;\">Không có bản ghi nào phù hợp trong MySQL.</td>\n      </tr>\n    </tbody>\n  </table>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1310,
        "y": 600,
        "wires": [
